{
 "schema_version": "1.0",
 "notes": "Every CSV is UTF-8 with comma separator and decimal point; floats have 4 decimals; every row starts with run_label and schema_version; rows are sorted.",
 "files": {
  "functions.csv": {
   "description": "One row per function or method (units of the AST script; identity = path, qualname, kind, ordinal)",
   "columns": [
    {
     "name": "run_label",
     "type": "string",
     "unit": "",
     "definition": "Label of the measurement run (--label)"
    },
    {
     "name": "schema_version",
     "type": "string",
     "unit": "",
     "definition": "Version of this schema"
    },
    {
     "name": "unit_id",
     "type": "string",
     "unit": "",
     "definition": "path::qualname::kind::ordinal; the line number is not part of it (D15)"
    },
    {
     "name": "path",
     "type": "string",
     "unit": "",
     "definition": "File relative to lms/"
    },
    {
     "name": "qualname",
     "type": "string",
     "unit": "",
     "definition": "Qualified name; nested functions as outer.<locals>.inner"
    },
    {
     "name": "kind",
     "type": "string",
     "unit": "",
     "definition": "function or method"
    },
    {
     "name": "nested",
     "type": "int",
     "unit": "0/1",
     "definition": "1 if defined inside another function"
    },
    {
     "name": "module_no",
     "type": "string",
     "unit": "",
     "definition": "Module number 1-29, or 'unassigned' (mapping file modules.csv)"
    },
    {
     "name": "module_name",
     "type": "string",
     "unit": "",
     "definition": "Module name"
    },
    {
     "name": "level",
     "type": "string",
     "unit": "",
     "definition": "simple, medium or complex of the module"
    },
    {
     "name": "lineno",
     "type": "int",
     "unit": "line",
     "definition": "Line of def"
    },
    {
     "name": "end_lineno",
     "type": "int",
     "unit": "line",
     "definition": "Last line"
    },
    {
     "name": "lines",
     "type": "int",
     "unit": "lines",
     "definition": "end_lineno - lineno + 1"
    },
    {
     "name": "sloc",
     "type": "int",
     "unit": "lines",
     "definition": "Code lines (no blank, comment or docstring lines)"
    },
    {
     "name": "params",
     "type": "int",
     "unit": "count",
     "definition": "Parameters, self and cls of methods not counted"
    },
    {
     "name": "nesting",
     "type": "int",
     "unit": "levels",
     "definition": "Deepest nesting of if/for/while/try/with/match blocks (elif is not deeper)"
    },
    {
     "name": "cc",
     "type": "int",
     "unit": "",
     "definition": "Cyclomatic complexity (Radon); nested functions are separate units"
    },
    {
     "name": "rank",
     "type": "string",
     "unit": "",
     "definition": "Radon rank A-F"
    },
    {
     "name": "cognitive",
     "type": "int",
     "unit": "",
     "definition": "Cognitive complexity (complexipy); empty for nested functions, which complexipy adds to their parent"
    },
    {
     "name": "halstead_volume",
     "type": "float",
     "unit": "",
     "definition": "Radon Halstead volume (units that are not nested only)"
    },
    {
     "name": "halstead_difficulty",
     "type": "float",
     "unit": "",
     "definition": "Radon Halstead difficulty"
    },
    {
     "name": "halstead_effort",
     "type": "float",
     "unit": "",
     "definition": "Radon Halstead effort"
    },
    {
     "name": "route_handler",
     "type": "int",
     "unit": "0/1",
     "definition": "1 if decorated like a FastAPI route (router.get(...), ...)"
    }
   ]
  },
  "classes.csv": {
   "description": "One row per class",
   "columns": [
    {
     "name": "run_label",
     "type": "string",
     "unit": "",
     "definition": "Label of the measurement run (--label)"
    },
    {
     "name": "schema_version",
     "type": "string",
     "unit": "",
     "definition": "Version of this schema"
    },
    {
     "name": "unit_id",
     "type": "string",
     "unit": "",
     "definition": "path::qualname::class::ordinal"
    },
    {
     "name": "path",
     "type": "string",
     "unit": "",
     "definition": "File relative to lms/"
    },
    {
     "name": "qualname",
     "type": "string",
     "unit": "",
     "definition": "Qualified class name"
    },
    {
     "name": "class_kind",
     "type": "string",
     "unit": "",
     "definition": "orm (SQLAlchemy), schema (Pydantic), enum or plain; resolved over the project's base classes"
    },
    {
     "name": "module_no",
     "type": "string",
     "unit": "",
     "definition": "Module number 1-29, or 'unassigned' (mapping file modules.csv)"
    },
    {
     "name": "module_name",
     "type": "string",
     "unit": "",
     "definition": "Module name"
    },
    {
     "name": "level",
     "type": "string",
     "unit": "",
     "definition": "simple, medium or complex of the module"
    },
    {
     "name": "lineno",
     "type": "int",
     "unit": "line",
     "definition": "Line of class"
    },
    {
     "name": "end_lineno",
     "type": "int",
     "unit": "line",
     "definition": "Last line"
    },
    {
     "name": "wmc",
     "type": "int",
     "unit": "",
     "definition": "Weighted methods per class: sum of the CC of the direct methods"
    },
    {
     "name": "nom",
     "type": "int",
     "unit": "count",
     "definition": "Number of methods"
    },
    {
     "name": "cbo",
     "type": "int",
     "unit": "count",
     "definition": "Distinct other project classes named in the class body (bases, annotations, calls)"
    },
    {
     "name": "lcom4",
     "type": "int",
     "unit": "count",
     "definition": "Connected components of the methods (shared self attributes or calls); 0 without methods"
    },
    {
     "name": "rfc",
     "type": "int",
     "unit": "count",
     "definition": "NOM + distinct names of functions and methods called by the methods"
    },
    {
     "name": "dit",
     "type": "int",
     "unit": "levels",
     "definition": "Depth of inheritance: 0 without base; an external base counts 1"
    },
    {
     "name": "noc",
     "type": "int",
     "unit": "count",
     "definition": "Direct subclasses in the project"
    },
    {
     "name": "fan_in",
     "type": "int",
     "unit": "count",
     "definition": "Other classes that name this class"
    },
    {
     "name": "fan_out",
     "type": "int",
     "unit": "count",
     "definition": "Same as cbo"
    }
   ]
  },
