# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
mutants/
.hypothesis/
*.bin
.env

# SQLite databases created by the LMS (default: lms.db)
*.db
*.db-journal

# Profiler and benchmark output
memray-*.bin
*.prof
.benchmarks/

# Editors and OS
.idea/
.vscode/
.DS_Store

# Test runner output: only the JSON summaries are kept (feedback.json, heldout.json, run.json)
results/**/*.junit.xml
results/**/*.log

# Analyzer: raw tool output of a measurement is not committed (docs/decisions/003)
results/baseline/**/raw/

# Run lock: exists while a test or measurement run is in progress (docs/environment.md)
.run.lock

# Trial measurements: the unit-level detail files are not committed (docs/decisions/003, addendum). They are
# regenerated from the measured code (analysis is deterministic), so that code must stay reachable. The final
# baseline results/baseline/final/ is committed in full.
results/baseline/trial/**/functions.csv
results/baseline/trial/**/classes.csv
results/baseline/trial/**/files.csv
results/baseline/trial/**/metrics_long.csv
results/baseline/trial/**/duplication.csv
results/baseline/trial/**/pyexamine.csv

# Token files of the experiment accounts (passed to docker --env-file, never committed)
.env.*

# Experiments (Week 5, ADR 004): the raw Claude Code logs and the unit-level detail files are not committed
# (ADR 003 rule); the code of every round is kept as the tag exp/<approach>/<run-id>/r<k>
results/experiments/**/stream.jsonl
results/experiments/**/stderr.txt
results/experiments/**/openapi/
results/experiments/**/functions.csv
results/experiments/**/classes.csv
results/experiments/**/files.csv
results/experiments/**/metrics_long.csv
results/experiments/**/duplication.csv
results/experiments/**/pyexamine.csv
